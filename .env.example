# Server
HOST=0.0.0.0
PORT=5772

# Database
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/ali_supplier?charset=utf8mb4

# Supplier ID (assigned by Alibaba)
SUPPLIER_ID=YOUR_SUPPLIER_ID

# Third-party supplier AES keys (provided by Alibaba upon onboarding)
THIRD_SUPPLIER_ID=YOUR_THIRD_SUPPLIER_ID
THIRD_DECRYPT_KEY=YOUR_32_CHAR_DECRYPT_KEY
THIRD_DECRYPT_IV=YOUR_16_CHAR_IV
THIRD_UPLOAD_KEY=YOUR_32_CHAR_UPLOAD_KEY
THIRD_UPLOAD_IV=YOUR_16_CHAR_IV
THIRD_CALLBACK_URL=http://dysms-apicloud.cn-zhangjiakou.aliyuncs.com/dysms/supplier/register/v1/callback
THIRD_SUBMIT_URL=http://dysms-apicloud.cn-zhangjiakou.aliyuncs.com/dysms/supplier/register/v1/submit
THIRD_QUERY_URL=http://dysms-apicloud.cn-zhangjiakou.aliyuncs.com/dysms/supplier/register/v1/query

# Direct supplier AES keys
DIRECT_SUPPLIER_ID=
DIRECT_AES_KEY=YOUR_32_CHAR_DIRECT_KEY
DIRECT_AES_IV=YOUR_16_CHAR_IV
DIRECT_CALLBACK_URL=http://pre-dysms-apicloud.cn-zhangjiakou.aliyuncs.com/dysms/supplier/register/v1/callback
